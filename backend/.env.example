SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# Default SQLite (created under backend/instance/app.db)
DATABASE_URL=sqlite:///instance/app.db

# Optional PostgreSQL (after docker compose up):
# DATABASE_URL=postgresql+psycopg://resume_matcher:resume_matcher@127.0.0.1:5432/resume_matcher

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

MAX_UPLOAD_MB=10
EMBEDDING_SKILL_THRESHOLD=0.55

# Demo seed (fictional recruiter only)
DEMO_EMAIL=demo.recruiter@example.com
DEMO_PASSWORD=demo-password-change-me
DEMO_NAME=Demo Recruiter

# Optional: path override for uploads (defaults to instance/uploads)
# UPLOAD_FOLDER=
